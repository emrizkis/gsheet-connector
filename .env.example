# Path ke file JSON kredensial Google Service Account Anda
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# ID Google Sheet yang ingin dibaca (terdapat pada URL sheet Anda)
# Contoh URL: https://docs.google.com/spreadsheets/d/ID_INI_YANG_DISALIN/edit
SPREADSHEET_ID=YOUR_SPREADSHEET_ID_HERE

# Range data yang ingin dibaca (contoh: "Sheet1!A1:D100" atau hanya "Sheet1" untuk membaca keseluruhan)
SHEET_RANGE=Sheet1!A1:E100

# Sprint ID yang ingin divisualisasikan (kosongkan jika tidak memakai filter)
FILTER_SPRINT_ID=YOUR_FILTER_SPRINT_ID_HERE

# Masa berlaku cache data Google Sheet (dalam detik)
CACHE_TTL_SECONDS=300

# Judul Utama Diagram / Board
GANTT_TITLE=Project Gantt Chart
KANBAN_TITLE=Project Kanban Board
